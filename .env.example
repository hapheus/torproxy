# Docker host port. The Compose file keeps this bound to 127.0.0.1.
TORPROXY_HOST_PORT=8118

# Privoxy listener inside the container.
TORPROXY_LISTEN_ADDRESS=0.0.0.0
TORPROXY_LISTEN_PORT=8118

# RESTful API listener inside the container and host port mapping.
TORPROXY_API_PORT=8080

# Tor SOCKS5 listener inside the container and host port mapping.
TORPROXY_SOCKS_PORT=9050

# Optional: Restrict which source CIDRs may use the SOCKS port
# (Tor SocksPolicy, ISSUE-18c). Comma-separated CIDRs, e.g.
# 172.16.0.0/12. Loopback is always accepted internally.
# Tor's SocksPort is unauthenticated by design — this is
# source-IP access control, not username/password auth.
# TORPROXY_SOCKS_ALLOWED_CIDRS=172.16.0.0/12

# Optional: Specific exit country code (e.g. DE, AT, US, or comma-separated DE,AT).
# TORPROXY_COUNTRY=DE

# Optional: Enforce strict exit node routing (1=strictly specified country, 0=allow fallback).
# TORPROXY_STRICT_NODES=1

# Optional: Periodically download Tor's GeoIP database (geoip/geoip6) from Tor
# Project GitLab and reload Tor, so country routing uses a fresh IP-to-country
# mapping. Disabled by default; on any download/validation failure the bundled
# or previously installed database keeps working (fallback).
# TORPROXY_GEOIP_AUTO_UPDATE=0
# TORPROXY_GEOIP_UPDATE_INTERVAL=86400
# TORPROXY_GEOIP_DIR=/var/lib/tor/geoip
# TORPROXY_GEOIP_URL=https://gitlab.torproject.org/tpo/core/tor/-/raw/main/src/config/geoip
# TORPROXY_GEOIP6_URL=https://gitlab.torproject.org/tpo/core/tor/-/raw/main/src/config/geoip6
# TORPROXY_GEOIP_MAX_BYTES=16777216
# TORPROXY_GEOIP6_MAX_BYTES=33554432

# Optional: Bearer token / API key to secure the REST management API (8080).
# Recommended if the management port or container network is accessible to other services.
# When set, requests require 'Authorization: Bearer <token>' or 'X-API-Key: <token>'.
# TORPROXY_API_TOKEN=your-random-secret-token-here

# Optional: Allow unauthenticated access to /health and /v1/health when TORPROXY_API_TOKEN is set
# (useful for Kubernetes / ALB liveness and readiness probes).
# TORPROXY_API_ALLOW_ANONYMOUS_HEALTH=0

# Optional: Enable transparent Tor Gateway mode (requires cap_add: [NET_ADMIN]).
# When true, outbound TCP and DNS traffic from containers sharing this network namespace
# are automatically redirected through Tor without client proxy configuration.
# TORPROXY_GATEWAY_MODE=0
# TORPROXY_TRANS_PORT=9040
# TORPROXY_DNS_PORT=9053

# Optional: API tuning (defaults preserve historical behaviour).
# TORPROXY_CACHE_TTL=30
# TORPROXY_REQUEST_TIMEOUT=3
# TORPROXY_MAX_WORKERS=32
# TORPROXY_MAX_BODY_BYTES=16384

# Model Context Protocol (MCP) server settings (ISSUE-122).
# Built-in zero-dependency MCP server on port 2501 for AI agents (Claude Desktop, Cursor, Antigravity).
# TORPROXY_MCP_ENABLED=1
# TORPROXY_MCP_PORT=2501
# TORPROXY_MCP_LISTEN_ADDRESS=0.0.0.0
