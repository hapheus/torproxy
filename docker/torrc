# Docker publishes this listener only on the host's loopback interface.
# Binding to all container interfaces is required for Docker port forwarding.
SocksPort 0.0.0.0:__TORPROXY_SOCKS_PORT__
ControlPort 127.0.0.1:9051
CookieAuthentication 1
DataDirectory /var/lib/tor
# Tor is launched as the dedicated unprivileged 'tor' user by start.sh
# (ISSUE-03); no User directive needed here since it would require
# setgroups privilege Tor does not have as a non-root user.
GeoIPFile /usr/share/tor/geoip
GeoIPv6File /usr/share/tor/geoip6
PidFile /tmp/tor.pid
RunAsDaemon 0
AvoidDiskWrites 1
ClientOnly 1
